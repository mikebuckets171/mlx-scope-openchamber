{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "lib": [
      "ES2022",
      "DOM"
    ],
    "types": [
      "bun-types",
      "node"
    ]
  },
  "include": [
    "panel/**/*.ts",
    "service/**/*.ts",
    "src/**/*.ts",
    "scripts/**/*.ts",
    "tests/browser/**/*.ts",
    "playwright.config.ts"
  ]
}
