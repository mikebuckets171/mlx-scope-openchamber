{
  "name": "mlx-scope-openchamber",
  "version": "5.1.2",
  "description": "Lightweight local model monitoring for OpenChamber.",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mikebuckets171/mlx-scope-openchamber.git"
  },
  "homepage": "https://github.com/mikebuckets171/mlx-scope-openchamber",
  "bugs": {
    "url": "https://github.com/mikebuckets171/mlx-scope-openchamber/issues"
  },
  "keywords": [
    "openchamber",
    "mlx",
    "omlx",
    "lmstudio",
    "mlx-lm",
    "vllm-mlx",
    "splash",
    "apple-silicon",
    "telemetry"
  ],
  "type": "module",
  "packageManager": "bun@1.4.2",
  "engines": {
    "node": ">=22.0.0"
  },
  "openchamber": {
    "apiVersion": 1,
    "engines": {
      "openchamber": ">=2.4.0"
    },
    "contributes": {
      "panel": {
        "id": "mlx-scope",
        "name": "MLX Scope",
        "icon": "panel/scope-icon.svg",
        "entry": "panel/index.html"
      },
      "statusSection": {
        "entry": "panel/index.html",
        "title": "MLX Scope",
        "height": 72
      },
      "actions": [
        {
          "id": "open-mlx-scope",
          "label": "Open MLX Scope",
          "icon": "panel/scope-icon.svg",
          "where": "session"
        }
      ],
      "service": {
        "entry": "service/main.js",
        "runtime": "host",
        "permissions": {
          "exec": [
            "/usr/bin/vm_stat",
            "/usr/sbin/sysctl",
            "/usr/sbin/ioreg",
            "/usr/bin/notifyutil",
            "/usr/sbin/lsof",
            "/usr/bin/footprint",
            "~/.lmstudio/bin/lms",
            "~/.cache/lm-studio/bin/lms",
            "/opt/homebrew/bin/macmon",
            "/usr/local/bin/macmon",
            "~/.config/opencode/bin/local-video"
          ]
        }
      },
      "page": true,
      "capabilities": [
        "sessions"
      ]
    }
  },
  "scripts": {
    "build": "bun run build:panel && bun run build:service",
    "build:panel": "openchamber-guest-bundle panel/main.ts panel/main.js && bun scripts/minify-guest.ts panel/main.js",
    "build:service": "bun build service/main.ts --target=node --format=esm --minify --outfile=service/main.js",
    "type-check": "tsc --noEmit",
    "test": "bun test ./service ./src ./panel ./scripts ./tests/fixtures && node --test bridge/opencode/*.test.js",
    "preview": "bun run build:panel && bun tests/browser/server.ts",
    "test:browser": "playwright test",
    "test:goldens": "playwright test tests/browser/goldens.spec.ts",
    "verify:package": "bun scripts/verify-package.ts",
    "check": "bun run type-check && bun run scan && bun run test && bun run test:helpers && bun run build && bun run verify:package",
    "check:all": "bun run check && bun run test:browser",
    "scan": "bun scripts/scan-committed.ts",
    "qualify:compatibility": "node scripts/qualify-compatibility.mjs",
    "overhead": "node scripts/measure-overhead.mjs",
    "test:helpers": "PYTHONDONTWRITEBYTECODE=1 python3 -m unittest discover -s bridge/comfyui -p \"test_*.py\""
  },
  "dependencies": {
    "@openchamber/sdk": "2.4.0",
    "jsonc-parser": "3.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.61.0",
    "@types/bun": "1.3.4",
    "@types/node": "24.3.1",
    "terser": "5.51.2",
    "typescript": "5.9.3",
    "acorn": "8.15.0"
  },
  "files": [
    "package.json",
    "README.md",
    "LICENSE",
    "PRIVACY.md",
    "SECURITY.md",
    "THIRD_PARTY_NOTICES.md",
    "CHANGELOG.md",
    "panel/index.html",
    "panel/main.js",
    "panel/style.css",
    "panel/scope-icon.svg",
    "service/main.js",
    "ui/tokens.css",
    "docs/CONFIGURATION.md",
    "docs/METRICS.md",
    "docs/ARCHITECTURE.md",
    "docs/COMPATIBILITY.md",
    "bridge/opencode/README.md",
    "bridge/opencode/package.json",
    "bridge/opencode/index.js",
    "bridge/opencode/compatibility.js",
    "bridge/opencode/store.js",
    "bridge/opencode/stream.js",
    "bridge/opencode/chat.js",
    "bridge/opencode/demand.js",
    "bridge/opencode/chat-store.js",
    "bridge/comfyui/__init__.py",
    "bridge/comfyui/snapshot.py",
    "bridge/comfyui/README.md",
    "docs/MEDIA.md",
    "docs/3.1/assets/media-light.png",
    "docs/3.1/assets/connections-light.png",
    "docs/5.0/assets/standard-instrument-dark.png",
    "docs/5.0/assets/standard-instrument-light.png",
    "docs/5.0/assets/standard-session-dark.png",
    "docs/5.0/assets/standard-session-light.png"
  ]
}
