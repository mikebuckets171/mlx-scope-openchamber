{
  "name": "mlx-scope-openchamber",
  "version": "2.1.5",
  "description": "Lightweight local model monitoring for OpenChamber.",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mikebuckets171/mlx-scope-openchamber.git"
  },
  "homepage": "https://github.com/mikebuckets171/mlx-scope-openchamber",
  "bugs": {
    "url": "https://github.com/mikebuckets171/mlx-scope-openchamber/issues"
  },
  "keywords": [
    "openchamber",
    "mlx",
    "omlx",
    "lmstudio",
    "mlx-lm",
    "vllm-mlx",
    "splash",
    "apple-silicon",
    "telemetry"
  ],
  "type": "module",
  "packageManager": "bun@1.4.2",
  "engines": {
    "node": ">=22.0.0"
  },
  "openchamber": {
    "apiVersion": 1,
    "engines": {
      "openchamber": ">=2.0.4"
    },
    "contributes": {
      "panel": {
        "id": "mlx-scope",
        "name": "MLX Scope",
        "icon": "panel/scope-icon.svg",
        "entry": "panel/index.html"
      },
      "statusSection": {
        "entry": "panel/index.html",
        "title": "MLX Scope",
        "height": 72
      },
      "background": {
        "entry": "background/index.html"
      },
      "actions": [
        {
          "id": "open-mlx-scope",
          "label": "Open MLX Scope",
          "icon": "panel/scope-icon.svg",
          "where": "session"
        }
      ],
      "commands": [
        {
          "name": "scope",
          "description": "Attach a private MLX Scope diagnostics summary"
        }
      ],
      "service": {
        "entry": "service/main.js",
        "runtime": "host",
        "permissions": {
          "exec": [
            "/usr/bin/vm_stat",
            "/usr/sbin/sysctl",
            "/usr/sbin/ioreg",
            "/usr/bin/notifyutil",
            "/usr/sbin/lsof",
            "/usr/bin/footprint",
            "~/.lmstudio/bin/lms",
            "~/.cache/lm-studio/bin/lms",
            "/opt/homebrew/bin/macmon",
            "/usr/local/bin/macmon"
          ]
        }
      },
      "page": true
    }
  },
  "scripts": {
    "build": "bun run build:panel && bun run build:service && bun run build:background",
    "build:panel": "openchamber-guest-bundle panel/main.ts panel/main.js && bun scripts/minify-guest.ts panel/main.js",
    "build:service": "bun build service/main.ts --target=node --format=esm --minify --outfile=service/main.js",
    "build:background": "openchamber-guest-bundle background/main.ts background/main.js && bun scripts/minify-guest.ts background/main.js",
    "type-check": "tsc --noEmit",
    "test": "bun test ./service ./src ./panel ./background ./scripts ./tests/fixtures",
    "preview": "bun run build:panel && bun run build:background && bun tests/browser/server.ts",
    "test:browser": "playwright test",
    "test:goldens": "playwright test tests/browser/goldens.spec.ts",
    "verify:package": "bun scripts/verify-package.ts",
    "check": "bun run type-check && bun run scan && bun run test && bun run build && bun run verify:package",
    "check:all": "bun run check && bun run test:browser",
    "scan": "bun scripts/scan-committed.ts",
    "overhead": "node scripts/measure-overhead.mjs"
  },
  "dependencies": {
    "@openchamber/sdk": "2.0.4",
    "jsonc-parser": "3.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.61.0",
    "@types/bun": "1.3.4",
    "@types/node": "24.3.1",
    "terser": "5.51.2",
    "typescript": "5.9.3"
  },
  "files": [
    "package.json",
    "README.md",
    "LICENSE",
    "PRIVACY.md",
    "SECURITY.md",
    "THIRD_PARTY_NOTICES.md",
    "CHANGELOG.md",
    "panel/index.html",
    "panel/main.js",
    "panel/style.css",
    "panel/scope-icon.svg",
    "service/main.js",
    "background/index.html",
    "background/main.js",
    "ui/tokens.css",
    "docs/CONFIGURATION.md",
    "docs/METRICS.md",
    "docs/ARCHITECTURE.md",
    "docs/COMPATIBILITY.md"
  ]
}
